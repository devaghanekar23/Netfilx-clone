pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'devaghanekar/netflix-clone'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_CRED_ID = 'docker-hub-credentials-2'
        K8S_NAMESPACE = 'movie-app'
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Validate Files') {
            steps {
                sh '''
                    set -e

                    test -f Dockerfile
                    test -f nginx.conf
                    test -f k8s/deployment.yml
                    test -f k8s/service.yml
                    test -f k8s/hpa.yml
                    test -f k8s/ingress.yml

                    echo "All required files are present"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'tmdb-api-key',
                        variable: 'VITE_TMDB_API_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        docker version

                        docker build \
                          --build-arg VITE_TMDB_API_KEY="$VITE_TMDB_API_KEY" \
                          -t ${DOCKER_IMAGE}:${IMAGE_TAG} .

                        docker tag \
                          ${DOCKER_IMAGE}:${IMAGE_TAG} \
                            ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CRED_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        set +x

                        printf '%s' "$DOCKER_PASS" |
                          docker login \
                          -u "$DOCKER_USER" \
                          --password-stdin

                        docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE}:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    echo "Checking Kubernetes connection..."
                    kubectl config current-context
                    kubectl get nodes

                    echo "Creating namespace..."
                    kubectl create namespace ${K8S_NAMESPACE} \
                      --dry-run=client -o yaml |
                      kubectl apply -f -

                    echo "Updating deployment image..."
                    sed -i \
                      "s|image:.*|image: ${DOCKER_IMAGE}:${IMAGE_TAG}|" \
                      k8s/deployment.yml

                    echo "Applying Kubernetes manifests..."
                    kubectl apply -f k8s/deployment.yml \
                      -n ${K8S_NAMESPACE}

                    kubectl apply -f k8s/service.yml \
                      -n ${K8S_NAMESPACE}

                    kubectl apply -f k8s/hpa.yml \
                      -n ${K8S_NAMESPACE}

                    kubectl apply -f k8s/ingress.yml \
                      -n ${K8S_NAMESPACE}

                    echo "Waiting for deployment rollout..."
                    kubectl rollout status deployment/movie-app \
                      -n ${K8S_NAMESPACE} \
                      --timeout=300s

                    echo "Checking Kubernetes resources..."
                    kubectl get pods -n ${K8S_NAMESPACE}
                    kubectl get deployments -n ${K8S_NAMESPACE}
                    kubectl get svc -n ${K8S_NAMESPACE}
                    kubectl get hpa -n ${K8S_NAMESPACE}
                    kubectl get ingress -n ${K8S_NAMESPACE}
                '''
            }
        }

        stage('Port Forward Application') {
            steps {
                sh '''
                    pkill -f 'kubectl port-forward.*movie-app-service' || true

                    nohup kubectl port-forward \
                      --address 0.0.0.0 \
                      svc/movie-app-service \
                      30080:80 \
                      -n ${K8S_NAMESPACE} \
                      > /tmp/port-forward.log 2>&1 < /dev/null &
        
                    sleep 3
                    cat /tmp/port-forward.log
                '''
            }
        }
    }

    post {
        always {
            sh '''
                docker logout || true
                docker rmi ${DOCKER_IMAGE}:${IMAGE_TAG} || true
                docker rmi ${DOCKER_IMAGE}:latest || true
            '''
            echo 'Pipeline execution finished.'
        }

        success {
            echo 'Netflix clone deployed successfully!'
        }

        failure {
            echo 'Pipeline failed. Review the Console Output.'
        }
    }
}
